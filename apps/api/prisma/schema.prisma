// =====================================================================================
//  Safarni (سفرني) — multi-tenant SaaS for tourism offices
//  PostgreSQL + Prisma 7. Every business table carries office_id (tenant) and, where the
//  business rule requires it, branch_id. Money is NUMERIC(14,2); never floating point.
// =====================================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ enums

enum RoleScope {
  OFFICE // sees every branch of the office (e.g. Admin)
  BRANCH // limited to the member's own branch (e.g. Reception)
}

enum SupplierType {
  HOTEL
  TRANSPORT
  RESTAURANT
}

enum TripType {
  VIP
  STANDARD
}

enum TripStatus {
  DRAFT // being prepared, not bookable
  OPEN // registration open, bookable
  REGISTRATION_CLOSED // deadline passed, waiting for the admin decision
  APPROVED // admin approved execution; confirmations still allowed until full
  COMPLETED
  CANCELLED
}

enum RegistrationDecisionType {
  APPROVE
  CANCEL
  EXTEND
}

enum BookingStatus {
  PENDING // does NOT consume seats
  CONFIRMED // consumes seats
  WAITING_LIST // does NOT consume seats
  CANCELLED // releases seats
}

enum BookingEventType {
  CREATED
  EDITED
  CONFIRMED
  WAITLISTED
  CANCELLED
  TRANSFERRED
  PASSENGERS_UPDATED
}

enum PaymentMethod {
  CASH
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  FAMILY_BOOK
  BIRTH_CERTIFICATE
  OTHER
}

enum Locale {
  AR
  EN
}

/// Which external supplier system an integration talks to.
enum IntegrationKind {
  HOTEL
  TRANSPORT
}

enum IntegrationStatus {
  NOT_CONFIGURED // manual supplier (no API) — the default, and always the case for restaurants
  CONFIGURED // settings saved, not verified yet
  ACTIVE // health check passed
  DISABLED
  ERROR // last health check failed
}

/// External reservation lifecycle. Independent from the internal BookingStatus on purpose:
/// an internally confirmed booking is NOT automatically confirmed by the hotel or coach company.
enum ExternalReservationStatus {
  NOT_REQUESTED
  CHECKING_AVAILABILITY
  AVAILABLE
  UNAVAILABLE
  PENDING // sent, provider has not confirmed yet
  CONFIRMED
  FAILED // provider rejected; safe to retry with a new attempt
  UNKNOWN // timeout/network error after sending: provider MAY have processed it → reconcile, never blind-retry
  CANCELLATION_PENDING
  CANCELLED
  CANCELLATION_FAILED
}

enum IntegrationOperation {
  HEALTH
  SEARCH
  DETAILS
  AVAILABILITY
  PRICING
  RESERVE
  GET_RESERVATION
  CANCEL
}

// ------------------------------------------------------------------ identity & organisation

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(190)
  phone           String?   @db.VarChar(40)
  fullName        String    @map("full_name") @db.VarChar(120)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  /// Safarni platform staff (manages offices, not office data)
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  isActive        Boolean   @default(true) @map("is_active")
  locale          Locale    @default(AR)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership    OfficeMember?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Office {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(150)
  /// Public URL: /{slug}
  slug                String   @unique @db.VarChar(80)
  description         String?
  phone               String?  @db.VarChar(40)
  whatsappNumber      String?  @map("whatsapp_number") @db.VarChar(40)
  email               String?  @db.VarChar(190)
  city                String?  @db.VarChar(100)
  country             String   @default("SY") @db.Char(2)
  address             String?  @db.VarChar(255)
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  logoUrl             String?  @map("logo_url") @db.VarChar(500)
  coverImageUrl       String?  @map("cover_image_url") @db.VarChar(500)
  brandColor          String   @default("#3F70AB") @map("brand_color") @db.VarChar(9)
  defaultCurrencyCode String   @default("SYP") @map("default_currency_code") @db.Char(3)
  defaultLocale       Locale   @default(AR) @map("default_locale")
  /// Optional public page + appearance on the Safarni showcase
  publicPageEnabled   Boolean  @default(false) @map("public_page_enabled")
  bookingTerms        String?  @map("booking_terms")
  cancellationTerms   String?  @map("cancellation_terms")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultCurrency      Currency              @relation(fields: [defaultCurrencyCode], references: [code])
  branches             Branch[]
  members              OfficeMember[]
  roles                Role[]
  currencies           OfficeCurrency[]
  tourCategories       TourCategory[]
  tours                Tour[]
  trips                Trip[]
  suppliers            Supplier[]
  supplierPayments     SupplierPayment[]
  customers            Customer[]
  bookings             Booking[]
  payments             Payment[]
  refunds              Refund[]
  offers               TripOffer[]
  banners              PromoBanner[]
  auditLogs            AuditLog[]
  integrations         SupplierIntegration[]
  externalReservations ExternalReservation[]
  integrationLogs      IntegrationLog[]

  @@map("offices")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String   @db.VarChar(120)
  city      String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office   Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  members  OfficeMember[]
  trips    Trip[]
  bookings Booking[]
  payments Payment[]

  @@unique([officeId, name])
  /// lets child tables reference (office_id, branch_id) so a row can never point to another office's branch
  @@unique([officeId, id])
  @@map("branches")
}

/// Configurable per office. Seeded with "Admin" (OFFICE scope) and "Reception" (BRANCH scope).
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  officeId    String    @map("office_id") @db.Uuid
  name        String    @db.VarChar(60)
  description String?   @db.VarChar(255)
  scope       RoleScope @default(BRANCH)
  /// Seeded roles cannot be deleted (they can still be edited)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office      Office           @relation(fields: [officeId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     OfficeMember[]

  @@unique([officeId, name])
  @@map("roles")
}

/// Global catalogue of permission keys, e.g. "bookings.confirm".
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(60)
  group       String  @db.VarChar(40)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Employment of a user in an office. An employee belongs to exactly ONE branch.
model OfficeMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  jobTitle  String?  @map("job_title") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  office           Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branch           Branch                     @relation(fields: [officeId, branchId], references: [officeId, id])
  role             Role                       @relation(fields: [roleId], references: [id])
  supervisedTrips  TripSupervisor[]
  decisions        TripRegistrationDecision[]
  bookingsCreated  Booking[]                  @relation("BookingCreatedBy")
  bookingEvents    BookingEvent[]
  paymentsRecorded Payment[]
  refundsRecorded  Refund[]
  supplierPayments SupplierPayment[]

  @@index([officeId, branchId])
  @@map("office_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token; the raw token is never stored
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Rotation family: reuse of a revoked token revokes the whole family
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------------ currencies

model Currency {
  code     String @id @db.Char(3)
  name     String @db.VarChar(60)
  nameAr   String @map("name_ar") @db.VarChar(60)
  symbol   String @db.VarChar(8)
  /// Display precision (SYP 0, USD 2). Storage is always NUMERIC(14,2).
  decimals Int    @default(2) @db.SmallInt

  offices        Office[]
  officeLinks    OfficeCurrency[]
  trips          Trip[]
  bookings       Booking[]
  payments       Payment[]
  refunds        Refund[]
  supplierPaymts SupplierPayment[]

  @@map("currencies")
}

model OfficeCurrency {
  officeId     String @map("office_id") @db.Uuid
  currencyCode String @map("currency_code") @db.Char(3)

  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code])

  @@id([officeId, currencyCode])
  @@map("office_currencies")
}

// ------------------------------------------------------------------ tours (reusable programs)

model TourCategory {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  name      String   @db.VarChar(80)
  nameAr    String?  @map("name_ar") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  tours  Tour[]

  @@unique([officeId, name])
  @@map("tour_categories")
}

/// The reusable program, e.g. "Damascus → Latakia, 4 days". Never mixed with Trip.
model Tour {
  id                 String   @id @default(uuid()) @db.Uuid
  officeId           String   @map("office_id") @db.Uuid
  categoryId         String?  @map("category_id") @db.Uuid
  name               String   @db.VarChar(160)
  slug               String   @db.VarChar(180)
  destination        String   @db.VarChar(120)
  description        String?
  days               Int      @db.SmallInt
  nights             Int      @db.SmallInt
  accommodationInfo  String?  @map("accommodation_info")
  transportationInfo String?  @map("transportation_info")
  bookingTerms       String?  @map("booking_terms")
  cancellationTerms  String?  @map("cancellation_terms")
  coverImageUrl      String?  @map("cover_image_url") @db.VarChar(500)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  office    Office        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  category  TourCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itinerary TourDay[]
  images    TourImage[]
  trips     Trip[]

  @@unique([officeId, slug])
  @@unique([officeId, id])
  @@index([officeId, categoryId])
  @@map("tours")
}

model TourDay {
  id          String  @id @default(uuid()) @db.Uuid
  tourId      String  @map("tour_id") @db.Uuid
  dayNumber   Int     @map("day_number") @db.SmallInt
  title       String  @db.VarChar(160)
  description String?
  location    String? @db.VarChar(120)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@map("tour_days")
}

model TourImage {
  id        String  @id @default(uuid()) @db.Uuid
  tourId    String  @map("tour_id") @db.Uuid
  url       String  @db.VarChar(500)
  caption   String? @db.VarChar(160)
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, sortOrder])
  @@map("tour_images")
}

// ------------------------------------------------------------------ trips (scheduled executions)

model Trip {
  id                        String     @id @default(uuid()) @db.Uuid
  officeId                  String     @map("office_id") @db.Uuid
  /// Each trip belongs to exactly one branch
  branchId                  String     @map("branch_id") @db.Uuid
  tourId                    String     @map("tour_id") @db.Uuid
  code                      String     @db.VarChar(24)
  tripType                  TripType   @map("trip_type")
  departureDate             DateTime   @map("departure_date") @db.Date
  returnDate                DateTime   @map("return_date") @db.Date
  currencyCode              String     @map("currency_code") @db.Char(3)
  minPassengers             Int        @map("min_passengers") @db.SmallInt
  maxSeats                  Int        @map("max_seats") @db.SmallInt
  /// Seats taken by CONFIRMED bookings only; changed atomically (see BookingsService)
  confirmedSeats            Int        @default(0) @map("confirmed_seats") @db.SmallInt
  registrationDeadline      DateTime   @map("registration_deadline") @db.Date
  registrationExtendedUntil DateTime?  @map("registration_extended_until") @db.Date
  status                    TripStatus @default(DRAFT)
  /// Listed on the office public page and Safarni showcase
  isPublic                  Boolean    @default(false) @map("is_public")
  /// Σ TripService.costPerPerson (cached; recomputed whenever services change)
  costPerPerson             Decimal    @default(0) @map("cost_per_person") @db.Decimal(14, 2)
  /// Σ TripService.sellingPricePerPerson before any offer (cached)
  sellingPricePerPerson     Decimal    @default(0) @map("selling_price_per_person") @db.Decimal(14, 2)
  notes                     String?
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  office         Office                     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branch         Branch                     @relation(fields: [officeId, branchId], references: [officeId, id])
  tour           Tour                       @relation(fields: [officeId, tourId], references: [officeId, id])
  currency       Currency                   @relation(fields: [currencyCode], references: [code])
  services       TripService[]
  supervisors    TripSupervisor[]
  decisions      TripRegistrationDecision[]
  offers         TripOffer[]
  bookings       Booking[]
  bookingEvents  BookingEvent[]             @relation("EventTrip")
  supplierPaymts SupplierPayment[]
  banners        PromoBanner[]

  @@unique([officeId, code])
  @@unique([officeId, id])
  @@index([officeId, branchId, departureDate])
  @@index([officeId, status, departureDate])
  @@index([isPublic, status, departureDate])
  @@map("trips")
}

model TripSupervisor {
  tripId   String @map("trip_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member OfficeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([tripId, memberId])
  @@map("trip_supervisors")
}

/// Admin decision when registration closes: approve, cancel or extend.
model TripRegistrationDecision {
  id                  String                   @id @default(uuid()) @db.Uuid
  tripId              String                   @map("trip_id") @db.Uuid
  decision            RegistrationDecisionType
  confirmedAtDecision Int                      @map("confirmed_at_decision") @db.SmallInt
  minPassengers       Int                      @map("min_passengers") @db.SmallInt
  previousDeadline    DateTime                 @map("previous_deadline") @db.Date
  newDeadline         DateTime?                @map("new_deadline") @db.Date
  note                String?                  @db.VarChar(500)
  decidedById         String                   @map("decided_by_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  decidedBy OfficeMember @relation(fields: [decidedById], references: [id])

  @@index([tripId, createdAt])
  @@map("trip_registration_decisions")
}

// ------------------------------------------------------------------ suppliers & pricing

model Supplier {
  id          String       @id @default(uuid()) @db.Uuid
  officeId    String       @map("office_id") @db.Uuid
  type        SupplierType
  name        String       @db.VarChar(150)
  contactName String?      @map("contact_name") @db.VarChar(120)
  phone       String?      @db.VarChar(40)
  address     String?      @db.VarChar(255)
  city        String?      @db.VarChar(100)
  notes       String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  office      Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  services    TripService[]
  payments    SupplierPayment[]
  integration SupplierIntegration?

  @@unique([officeId, id])
  @@index([officeId, type])
  @@map("suppliers")
}

/// One service per type per trip. Selling = cost × (1 + profit%).
model TripService {
  id                    String       @id @default(uuid()) @db.Uuid
  officeId              String       @map("office_id") @db.Uuid
  tripId                String       @map("trip_id") @db.Uuid
  supplierId            String       @map("supplier_id") @db.Uuid
  serviceType           SupplierType @map("service_type")
  description           String?      @db.VarChar(255)
  costPerPerson         Decimal      @map("cost_per_person") @db.Decimal(14, 2)
  /// e.g. 15.00 means 15 %
  profitPercent         Decimal      @map("profit_percent") @db.Decimal(6, 2)
  sellingPricePerPerson Decimal      @map("selling_price_per_person") @db.Decimal(14, 2)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip                 Trip                  @relation(fields: [officeId, tripId], references: [officeId, id], onDelete: Cascade)
  supplier             Supplier              @relation(fields: [officeId, supplierId], references: [officeId, id])
  externalReservations ExternalReservation[]

  @@unique([tripId, serviceType])
  @@index([supplierId])
  @@map("trip_services")
}

/// Money the office paid a supplier (e.g. the coach company's net share).
model SupplierPayment {
  id           String        @id @default(uuid()) @db.Uuid
  officeId     String        @map("office_id") @db.Uuid
  supplierId   String        @map("supplier_id") @db.Uuid
  tripId       String?       @map("trip_id") @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  currencyCode String        @map("currency_code") @db.Char(3)
  method       PaymentMethod @default(CASH)
  reference    String?       @db.VarChar(80)
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  notes        String?
  recordedById String        @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  office     Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  supplier   Supplier     @relation(fields: [officeId, supplierId], references: [officeId, id])
  trip       Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  currency   Currency     @relation(fields: [currencyCode], references: [code])
  recordedBy OfficeMember @relation(fields: [recordedById], references: [id])

  @@index([officeId, supplierId])
  @@index([tripId])
  @@map("supplier_payments")
}

model TripOffer {
  id            String       @id @default(uuid()) @db.Uuid
  officeId      String       @map("office_id") @db.Uuid
  tripId        String       @map("trip_id") @db.Uuid
  title         String       @db.VarChar(120)
  description   String?      @db.VarChar(500)
  discountType  DiscountType @map("discount_type")
  /// percent (0-100) or amount in the trip currency
  discountValue Decimal      @map("discount_value") @db.Decimal(14, 2)
  startsAt      DateTime     @map("starts_at") @db.Date
  endsAt        DateTime     @map("ends_at") @db.Date
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  office   Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  trip     Trip      @relation(fields: [officeId, tripId], references: [officeId, id], onDelete: Cascade)
  bookings Booking[]

  @@index([tripId, isActive, startsAt, endsAt])
  @@map("trip_offers")
}

// ------------------------------------------------------------------ customers & bookings

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  officeId       String    @map("office_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(160)
  phone          String    @db.VarChar(40)
  nationalId     String?   @map("national_id") @db.VarChar(40)
  passportNumber String?   @map("passport_number") @db.VarChar(40)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  address        String?   @db.VarChar(255)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office   Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([officeId, phone])
  @@unique([officeId, id])
  @@index([officeId, fullName])
  @@map("customers")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  officeId           String        @map("office_id") @db.Uuid
  /// Always the trip's branch
  branchId           String        @map("branch_id") @db.Uuid
  tripId             String        @map("trip_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  reference          String        @db.VarChar(20)
  status             BookingStatus @default(PENDING)
  passengerCount     Int           @map("passenger_count") @db.SmallInt
  /// Inherited from the trip; every payment must use it
  currencyCode       String        @map("currency_code") @db.Char(3)
  // ---- price snapshot (never changes when the trip price changes) ----
  unitPrice          Decimal       @map("unit_price") @db.Decimal(14, 2)
  unitCost           Decimal       @map("unit_cost") @db.Decimal(14, 2)
  subtotal           Decimal       @db.Decimal(14, 2)
  offerId            String?       @map("offer_id") @db.Uuid
  offerTitle         String?       @map("offer_title") @db.VarChar(120)
  discountType       DiscountType? @map("discount_type")
  discountValue      Decimal?      @map("discount_value") @db.Decimal(14, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(14, 2)
  // ---- money received (maintained in the same transaction as payments/refunds) ----
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  refundedAmount     Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  notes              String?
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(255)
  createdById        String        @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  office               Office                @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [officeId, branchId], references: [officeId, id])
  trip                 Trip                  @relation(fields: [officeId, tripId], references: [officeId, id])
  customer             Customer              @relation(fields: [officeId, customerId], references: [officeId, id])
  currency             Currency              @relation(fields: [currencyCode], references: [code])
  offer                TripOffer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdBy            OfficeMember          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  passengers           BookingPassenger[]
  externalReservations ExternalReservation[]
  payments             Payment[]
  refunds              Refund[]
  events               BookingEvent[]

  @@unique([officeId, reference])
  @@unique([officeId, id])
  @@index([officeId, branchId, status, createdAt])
  @@index([tripId, status])
  @@index([customerId])
  @@map("bookings")
}

/// Every traveller has an individual record (the customer is the contact, not necessarily a passenger).
model BookingPassenger {
  id             String       @id @default(uuid()) @db.Uuid
  bookingId      String       @map("booking_id") @db.Uuid
  fullName       String       @map("full_name") @db.VarChar(160)
  dateOfBirth    DateTime?    @map("date_of_birth") @db.Date
  nationality    String?      @db.VarChar(80)
  documentType   DocumentType @default(NATIONAL_ID) @map("document_type")
  documentNumber String?      @map("document_number") @db.VarChar(40)
  notes          String?      @db.VarChar(500)
  /// Trip-day attendance (set by the trip supervisor); null = not checked yet
  attended       Boolean?
  sortOrder      Int          @default(0) @map("sort_order") @db.SmallInt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_passengers")
}

/// Immutable history of a booking (status changes, transfers with the old price snapshot, edits).
model BookingEvent {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @map("booking_id") @db.Uuid
  type       BookingEventType
  fromTripId String?          @map("from_trip_id") @db.Uuid
  toTripId   String?          @map("to_trip_id") @db.Uuid
  data       Json?
  actorId    String?          @map("actor_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  toTrip  Trip?         @relation("EventTrip", fields: [toTripId], references: [id], onDelete: SetNull)
  actor   OfficeMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ------------------------------------------------------------------ payments & refunds

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  officeId       String        @map("office_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  /// Always equal to the booking currency
  currencyCode   String        @map("currency_code") @db.Char(3)
  method         PaymentMethod @default(CASH)
  receiptNumber  String        @map("receipt_number") @db.VarChar(30)
  paidAt         DateTime      @map("paid_at") @db.Timestamptz(3)
  notes          String?       @db.VarChar(500)
  /// Σ refunds against this payment (never above amount)
  refundedAmount Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  recordedById   String        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  office     Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [officeId, branchId], references: [officeId, id])
  booking    Booking      @relation(fields: [officeId, bookingId], references: [officeId, id])
  currency   Currency     @relation(fields: [currencyCode], references: [code])
  recordedBy OfficeMember @relation(fields: [recordedById], references: [id])
  refunds    Refund[]

  @@unique([officeId, receiptNumber])
  @@unique([officeId, id])
  @@index([officeId, branchId, paidAt])
  @@index([bookingId])
  @@map("payments")
}

/// Linked to the original payment; partial refunds allowed, never above the payment.
model Refund {
  id           String   @id @default(uuid()) @db.Uuid
  officeId     String   @map("office_id") @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  currencyCode String   @map("currency_code") @db.Char(3)
  reason       String   @db.VarChar(255)
  refundedAt   DateTime @map("refunded_at") @db.Timestamptz(3)
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office     Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  payment    Payment      @relation(fields: [officeId, paymentId], references: [officeId, id])
  booking    Booking      @relation(fields: [officeId, bookingId], references: [officeId, id])
  currency   Currency     @relation(fields: [currencyCode], references: [code])
  recordedBy OfficeMember @relation(fields: [recordedById], references: [id])

  @@index([officeId, refundedAt])
  @@index([paymentId])
  @@map("refunds")
}

// ------------------------------------------------------------------ external supplier integrations
// Foundation only: adapters are implemented once the hotel and transport API documentation is
// available. Secrets are NEVER stored here — only the name of the server-side secret to use.

model SupplierIntegration {
  id                 String            @id @default(uuid()) @db.Uuid
  officeId           String            @map("office_id") @db.Uuid
  supplierId         String            @map("supplier_id") @db.Uuid
  kind               IntegrationKind
  status             IntegrationStatus @default(NOT_CONFIGURED)
  /// The supplier's identifier inside the external system (e.g. hotel id, operator id)
  externalSupplierId String?           @map("external_supplier_id") @db.VarChar(120)
  baseUrl            String?           @map("base_url") @db.VarChar(300)
  /// Name of the server-side secret (env var / vault key) holding the credentials. Never the secret itself.
  credentialRef      String?           @map("credential_ref") @db.VarChar(120)
  /// Capabilities confirmed from the provider's documentation (search, availability, reserve, cancel...)
  capabilities       Json?
  lastHealthCheckAt  DateTime?         @map("last_health_check_at") @db.Timestamptz(3)
  lastHealthOk       Boolean?          @map("last_health_ok")
  lastError          String?           @map("last_error") @db.VarChar(500)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  office       Office                @relation(fields: [officeId], references: [id], onDelete: Cascade)
  supplier     Supplier              @relation(fields: [officeId, supplierId], references: [officeId, id], onDelete: Cascade)
  reservations ExternalReservation[]
  logs         IntegrationLog[]

  @@unique([officeId, supplierId])
  @@unique([officeId, id])
  @@map("supplier_integrations")
}

/// One external reservation per (booking, trip service). Separate from the internal booking.
model ExternalReservation {
  id                String                    @id @default(uuid()) @db.Uuid
  officeId          String                    @map("office_id") @db.Uuid
  bookingId         String                    @map("booking_id") @db.Uuid
  tripServiceId     String                    @map("trip_service_id") @db.Uuid
  integrationId     String                    @map("integration_id") @db.Uuid
  kind              IntegrationKind
  status            ExternalReservationStatus @default(NOT_REQUESTED)
  /// Sent to the provider (when supported) so a repeated request can never create a second reservation
  idempotencyKey    String                    @unique @map("idempotency_key") @db.VarChar(80)
  externalReference String?                   @map("external_reference") @db.VarChar(120)
  quantity          Int                       @db.SmallInt
  attempts          Int                       @default(0) @db.SmallInt
  lastError         String?                   @map("last_error") @db.VarChar(500)
  /// Normalised, non-personal details returned by the provider (room type, seat numbers, price...)
  details           Json?
  lastSyncedAt      DateTime?                 @map("last_synced_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office      Office              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  booking     Booking             @relation(fields: [officeId, bookingId], references: [officeId, id], onDelete: Cascade)
  tripService TripService         @relation(fields: [tripServiceId], references: [id])
  integration SupplierIntegration @relation(fields: [officeId, integrationId], references: [officeId, id])
  logs        IntegrationLog[]

  @@unique([bookingId, tripServiceId])
  @@index([officeId, status])
  @@map("external_reservations")
}

/// Request/response metadata for every external call. No credentials, no passenger data, no bodies.
model IntegrationLog {
  id                    String               @id @default(uuid()) @db.Uuid
  officeId              String               @map("office_id") @db.Uuid
  integrationId         String               @map("integration_id") @db.Uuid
  externalReservationId String?              @map("external_reservation_id") @db.Uuid
  operation             IntegrationOperation
  httpMethod            String               @map("http_method") @db.VarChar(8)
  /// Path only, never query strings (they may carry keys)
  endpoint              String               @db.VarChar(200)
  statusCode            Int?                 @map("status_code") @db.SmallInt
  durationMs            Int                  @map("duration_ms")
  success               Boolean
  errorCode             String?              @map("error_code") @db.VarChar(60)
  errorMessage          String?              @map("error_message") @db.VarChar(500)
  correlationId         String               @map("correlation_id") @db.VarChar(80)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  office      Office               @relation(fields: [officeId], references: [id], onDelete: Cascade)
  integration SupplierIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  reservation ExternalReservation? @relation(fields: [externalReservationId], references: [id], onDelete: SetNull)

  @@index([integrationId, createdAt])
  @@index([officeId, createdAt])
  @@map("integration_logs")
}

// ------------------------------------------------------------------ marketing & audit

/// Animated ads on the Safarni landing page and the office page.
model PromoBanner {
  id        String   @id @default(uuid()) @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  tripId    String?  @map("trip_id") @db.Uuid
  title     String   @db.VarChar(120)
  subtitle  String?  @db.VarChar(200)
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  startsAt  DateTime @map("starts_at") @db.Date
  endsAt    DateTime @map("ends_at") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@map("promo_banners")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String?  @map("office_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String   @db.VarChar(255)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  office Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([officeId, createdAt])
  @@index([officeId, entityType, entityId])
  @@map("audit_logs")
}
