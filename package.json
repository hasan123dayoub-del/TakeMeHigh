{
  "name": "travelos",
  "version": "0.1.0",
  "private": true,
  "description": "TakeMeHigh: operations system for one travel agency (single-tenant).",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-takemehigh.ps1",
    "postinstall": "npm run build -w @travelos/shared",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @travelos/api\" \"npm run dev -w @travelos/web\"",
    "dev:api": "npm run dev -w @travelos/api",
    "dev:web": "npm run dev -w @travelos/web",
    "build": "npm run build -w @travelos/shared && npm run build -w @travelos/api && npm run build -w @travelos/web",
    "lint": "npm run lint -w @travelos/api && npm run lint -w @travelos/web",
    "test": "npm run test -w @travelos/api",
    "test:e2e": "npm run test:e2e -w @travelos/api",
    "db:migrate": "npm run db:migrate -w @travelos/api",
    "db:seed": "npm run db:seed -w @travelos/api",
    "db:reset": "npm run db:reset -w @travelos/api",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "db:migrate:dev": "npm run db:migrate:dev -w @travelos/api",
    "db:studio": "npm run db:studio -w @travelos/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.4.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false
  }
}
