@startuml TravelOS_UseCases
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F2F8FD
  BorderColor #3F70AB
}

actor "Owner" as Owner
actor "Administrator" as Admin
actor "Operations Manager" as Ops
actor "Booking Agent" as Agent
actor "Accountant" as Acc
actor "Traveller" as Trav <<external>>

Admin -|> Owner : <<subset of>>

rectangle "TravelOS" {
  usecase "Sign in" as UC1
  usecase "View dashboard" as UC2
  usecase "Manage trips & offers" as UC3
  usecase "Plan itinerary" as UC4
  usecase "Manage suppliers" as UC5
  usecase "Attach supplier services" as UC6
  usecase "Create booking" as UC7
  usecase "Record payment" as UC8
  usecase "Cancel booking" as UC9
  usecase "Issue refund" as UC10
  usecase "Print confirmation" as UC11
  usecase "Manage customers" as UC12
  usecase "Record expense" as UC13
  usecase "View reports" as UC14
  usecase "Manage team & settings" as UC15
  usecase "Browse public agency page" as UC16
  usecase "Request booking online" as UC17
  usecase "Confirm online request" as UC18
}

Owner --> UC1
Owner --> UC2
Owner --> UC14
Owner --> UC15
Owner --> UC10
Admin --> UC15
Ops --> UC1
Ops --> UC3
Ops --> UC4
Ops --> UC5
Ops --> UC6
Ops --> UC14
Agent --> UC1
Agent --> UC2
Agent --> UC7
Agent --> UC8
Agent --> UC9
Agent --> UC11
Agent --> UC12
Agent --> UC18
Acc --> UC1
Acc --> UC8
Acc --> UC10
Acc --> UC13
Acc --> UC14
Trav --> UC16
Trav --> UC17

UC7 ..> UC12 : <<include>>
UC10 ..> UC9 : <<extend>>
UC17 ..> UC7 : <<include>>
UC18 ..> UC8 : <<include>>
UC3 ..> UC4 : <<extend>>
@enduml
