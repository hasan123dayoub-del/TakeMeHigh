@startuml Safarni_UseCases
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F2F8FD
  BorderColor #3F70AB
}

actor "Admin\n(office scope)" as Admin
actor "Reception\n(branch scope)" as Rec
actor "Trip supervisor" as Sup
actor "Platform admin" as Plat
actor "Visitor" as Vis <<external>>
actor "Hotel / transport\nsystem" as Ext <<external, future>>

Admin -|> Rec : <<can also>>

rectangle "Safarni" {
  usecase "Sign in / refresh / sign out" as UC1
  usecase "Onboard & activate office" as UC2
  usecase "Manage branches, staff & roles" as UC3
  usecase "Manage tours" as UC4
  usecase "Schedule trip & price services" as UC5
  usecase "Manage offers & ads" as UC6
  usecase "Decide after deadline\n(approve / extend / cancel)" as UC7
  usecase "Manage customers" as UC8
  usecase "Create booking with passengers" as UC9
  usecase "Confirm / waitlist / cancel" as UC10
  usecase "Transfer booking" as UC11
  usecase "Cash payment & receipt" as UC12
  usecase "Refund" as UC13
  usecase "Supplier payment" as UC14
  usecase "Dashboard & reports (Excel/PDF)" as UC15
  usecase "Passenger list & attendance" as UC16
  usecase "Browse showcase / office page" as UC17
  usecase "Contact office on WhatsApp" as UC18
  usecase "External reservation" as UC19
}

Plat --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC11
Admin --> UC13
Admin --> UC14
Rec --> UC1
Rec --> UC8
Rec --> UC9
Rec --> UC10
Rec --> UC12
Rec --> UC15
Sup --> UC16
Vis --> UC17
Vis --> UC18
UC19 --> Ext

UC9 ..> UC8 : <<include>>
UC13 ..> UC10 : <<extend>>
UC17 ..> UC18 : <<include>>
UC19 ..> UC10 : <<extend>>
@enduml
