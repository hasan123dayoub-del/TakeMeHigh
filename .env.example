# ---------- Database: XAMPP MySQL (MariaDB 10.4) ----------
# XAMPP default is user "root" with an empty password. Start MySQL from the XAMPP Control Panel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travelos

# ---------- API ----------
API_PORT=3001
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
