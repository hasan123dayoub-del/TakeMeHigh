# ---------- Database: PostgreSQL (Prisma) ----------
# One database per client installation (single-tenant). Create the role and database once
# (see README "Getting started"), then:
DATABASE_URL=postgresql://takemehigh:change-me@localhost:5432/takemehigh?schema=public

# ---------- API ----------
API_PORT=3001
# Public address of the API (used in image and signed-file links)
API_PUBLIC_URL=http://localhost:3001
# Access tokens are short-lived; refresh tokens rotate on every use and expire after 30 idle minutes.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7
# Encrypts supplier credentials at rest (AES-256-GCM). Falls back to JWT_SECRET when empty.
CREDENTIALS_KEY=replace-with-another-long-random-string
CORS_ORIGIN=http://localhost:3000
# Where uploaded images and identity documents are stored (default: <repo>/uploads)
# UPLOAD_DIR=
# Built-in stand-in for the hotel/transport/restaurant platforms until their documentation arrives
SUPPLIER_SANDBOX=true
SANDBOX_SUPPLIER_KEY=sandbox-demo-key
# Set to true to stop the background jobs (registration deadlines, supplier sync), e.g. in tests
# DISABLE_SCHEDULER=false

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
